{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "internet-archaeology-machine",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-30",
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  }
}
