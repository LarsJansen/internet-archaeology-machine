{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "internet-archaeology-machine",
  "main": "src/worker/entry.ts",
  "compatibility_date": "2026-10-30",
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "internet-archaeology-machine-screenshots"
    }
  ],
  "assets": {
    "directory": "./dist",
    "run_worker_first": [
      "/api/*",
      "/discover/*"
    ],
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCREENSHOT_BUDGET",
        "class_name": "ScreenshotBudget"
      }
    ]
  },
  "exports": {
    "ScreenshotBudget": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "PUBLIC_SCREENSHOTS_ENABLED": "true"
  }
}
