{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "vitest/importMeta"]
  },
  "include": ["src/worker", "src/shared", "tests/domain-validation.test.ts", "tests/cdx-parser.test.ts", "tests/worker.test.ts"]
}
