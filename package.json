{
  "name": "internet-archaeology-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, honest interface for exploring surviving Internet Archive captures.",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "dev": "npm run build && wrangler dev",
    "dev:client": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
